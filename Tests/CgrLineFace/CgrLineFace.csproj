<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <EncoderDir Condition="'$(EncoderDir)' == ''">../../ExportByColor</EncoderDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(EncoderDir)/CgrWriter.cs" Link="CgrWriter.cs" />
    <Compile Include="$(EncoderDir)/CgrCanonical95.cs" Link="CgrCanonical95.cs" />
    <Compile Include="$(EncoderDir)/RoundHoleReconstruction.cs" Link="RoundHoleReconstruction.cs" />
    <Compile Include="$(EncoderDir)/RoundHoleCgrMesh.cs" Link="RoundHoleCgrMesh.cs" />
    <Compile Include="$(EncoderDir)/RoundHoleCgrPlanarCaps.cs" Link="RoundHoleCgrPlanarCaps.cs" />
    <Compile Include="$(EncoderDir)/Vendor/EarCut/*.cs" Link="Vendor/EarCut/%(Filename)%(Extension)" />
    <Compile Include="$(EncoderDir)/CgrCompact95.cs" Link="CgrCompact95.cs" />
    <Compile Include="$(EncoderDir)/CgrTemplate.cs" Link="CgrTemplate.cs" />
    <Compile Include="$(EncoderDir)/CgrSurfaceOrientation.cs" Link="CgrSurfaceOrientation.cs" />
    <Compile Include="$(EncoderDir)/CgrLineFace95.cs" Link="CgrLineFace95.cs" Condition="Exists('$(EncoderDir)/CgrLineFace95.cs')" />
    <Compile Include="$(EncoderDir)/CgrFeatureCompression.cs" Link="CgrFeatureCompression.cs" Condition="Exists('$(EncoderDir)/CgrFeatureCompression.cs')" />
    <Compile Include="$(EncoderDir)/CgrFeatureCfv3Adapter.cs" Link="CgrFeatureCfv3Adapter.cs" Condition="Exists('$(EncoderDir)/CgrFeatureCfv3Adapter.cs')" />
    <Compile Include="../../ExportByColor/Cfv3Encoder.cs" Link="Cfv3Encoder.cs" />
    <Compile Include="../../ExportByColor/ThreeDXmlWriter.cs" Link="ThreeDXmlWriter.cs" />
  </ItemGroup>
</Project>
