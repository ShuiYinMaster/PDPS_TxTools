<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\..\build\Workspace.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>TxTools.JtCgrWorker</AssemblyName><PlatformTarget>x64</PlatformTarget>
    <OutputPath>$(TxToolsBuildRoot)bin\JtCgrWorker\$(Configuration)\</OutputPath>
    <LangVersion>7.3</LangVersion>
    <TxToolsAssembly Condition="'$(TxToolsAssembly)' == ''">$(TxToolsBuildRoot)bin\TxTools\$(Configuration)\TxTools.dll</TxToolsAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/>
    <Reference Include="TxTools"><HintPath>$(TxToolsAssembly)</HintPath><Private>false</Private></Reference>
    <Compile Include="CgrWorker.cs"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
