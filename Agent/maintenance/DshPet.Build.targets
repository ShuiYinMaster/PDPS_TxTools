<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Runtime files are sidecars: keep video decoding out of the Process Simulate process. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\Core\Multi\DesktopPetSession.cs" />
    <Content Include="$(MSBuildThisFileDirectory)..\UI\pet\dsh-pet\**\*">
      <Link>Agent\UI\pet\dsh-pet\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(TxToolsPetComponentsDir)electron\**\*">
      <Link>Agent\UI\pet\dsh-pet\electron\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(TxToolsPetComponentsDir)assets\**\*">
      <Link>Agent\UI\pet\dsh-pet\assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
