<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RecipeDefaultsDirectory>$(MSBuildThisFileDirectory)..\recipes\defaults</RecipeDefaultsDirectory>
    <RecipeMigrationsDirectory>$(MSBuildThisFileDirectory)recipe-migrations</RecipeMigrationsDirectory>
    <!-- Let MSBuild discover files added after the IDE loaded the project.
         Compiler incremental checks still avoid unnecessary compilation. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <!-- Refresh at execution time, before resource paths and manifest names are
       assigned. A project-evaluation item list can be stale in Visual Studio. -->
  <Target Name="CollectBundledRecipeResources" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)"
        Condition="$([System.String]::Copy('%(EmbeddedResource.LogicalName)').StartsWith('TxTools.Agent.DefaultRecipes.')) Or $([System.String]::Copy('%(EmbeddedResource.LogicalName)').StartsWith('TxTools.Agent.LegacyRecipes.'))" />
      <_RecipeDefaultInputs Remove="@(_RecipeDefaultInputs)" />
      <_RecipeMigrationInputs Remove="@(_RecipeMigrationInputs)" />
      <_RecipeDefaultInputs Include="$(RecipeDefaultsDirectory)\*.md" />
      <_RecipeMigrationInputs Include="$(RecipeMigrationsDirectory)\*.md" />
      <EmbeddedResource Include="@(_RecipeDefaultInputs)">
        <LogicalName>TxTools.Agent.DefaultRecipes.%(_RecipeDefaultInputs.Filename)%(_RecipeDefaultInputs.Extension)</LogicalName>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
      <EmbeddedResource Include="@(_RecipeMigrationInputs)">
        <LogicalName>TxTools.Agent.LegacyRecipes.%(_RecipeMigrationInputs.Filename)%(_RecipeMigrationInputs.Extension)</LogicalName>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <!-- Check the actual DLL, rather than treating a successful compile as proof
       that Visual Studio embedded the current definitions and migration baselines. -->
  <PropertyGroup>
    <!-- A 32-bit MSBuild must use Sysnative to inspect the x64 plugin DLL. -->
    <RecipeValidationPowerShell Condition="'$(RecipeValidationPowerShell)' == '' and Exists('$(SystemRoot)\Sysnative\WindowsPowerShell\v1.0\powershell.exe')">$(SystemRoot)\Sysnative\WindowsPowerShell\v1.0\powershell.exe</RecipeValidationPowerShell>
    <RecipeValidationPowerShell Condition="'$(RecipeValidationPowerShell)' == ''">$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe</RecipeValidationPowerShell>
  </PropertyGroup>
  <Target Name="ValidateRecipeResources" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(RecipeValidationPowerShell)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)VerifyRecipeResources.ps1&quot; -AssemblyPath &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
